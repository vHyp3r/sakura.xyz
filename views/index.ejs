<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>

  <!-- Hero -->
  <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
    <div class="absolute inset-0 grid-bg opacity-40"></div>
    <div class="absolute top-1/4 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full hero-glow blur-3xl animate-pulse-glow"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <div class="animate-fade-up">
          <span class="section-label">
            <span class="inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Fast &amp; Secure Minecraft Utilities
          </span>
        </div>

        <h1 class="mt-8 text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl animate-fade-up-delay-1">
          Power your Minecraft world with
          <span class="gradient-text"> lightning-fast tools</span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-400 sm:text-xl animate-fade-up-delay-2">
          Sakura.xyz delivers secure hosting, instant conversions, and reliable utilities — so you spend less time waiting and more time playing.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row animate-fade-up-delay-3">
          <a href="#get-started" class="btn-primary w-full sm:w-auto">
            Start for free
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="#services" class="btn-secondary w-full sm:w-auto">Explore services</a>
        </div>

        <!-- Trust badges -->
        <div class="mt-16 grid grid-cols-2 gap-6 sm:grid-cols-4 animate-fade-up-delay-4">
          <div class="glass-card px-4 py-5 text-center">
            <p class="stat-value text-pink-400">&lt;50ms</p>
            <p class="stat-label">Avg. API response</p>
          </div>
          <div class="glass-card px-4 py-5 text-center">
            <p class="stat-value text-emerald-400">256-bit</p>
            <p class="stat-label">Encryption at rest</p>
          </div>
          <div class="glass-card px-4 py-5 text-center">
            <p class="stat-value">99.9%</p>
            <p class="stat-label">Uptime SLA</p>
          </div>
          <div class="glass-card px-4 py-5 text-center">
            <p class="stat-value">10K+</p>
            <p class="stat-label">Packs processed</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <span class="section-label">Why Sakura</span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Built for speed. Engineered for trust.
        </h2>
        <p class="mt-4 text-gray-400">
          Every tool on our platform is optimized for low latency and hardened against abuse — because your packs and data deserve both.
        </p>
      </div>

      <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Blazing Fast Delivery</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Global edge caching serves texture packs and assets in milliseconds — no matter where your players are.
          </p>
        </div>

        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Secure by Default</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            End-to-end encrypted uploads, malware scanning, and signed download links keep your files safe from upload to install.
          </p>
        </div>

        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Instant Conversion</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Convert Java resource packs to Bedrock .mcpack format in seconds with our automated pipeline — no manual steps.
          </p>
        </div>

        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Smart Discovery</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Search, filter, and browse thousands of community packs with tags, resolution filters, and trending rankings.
          </p>
        </div>

        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Developer API</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            RESTful endpoints for upload, conversion, and metadata — integrate Sakura into your bot, server, or launcher.
          </p>
        </div>

        <div class="glass-card-hover p-8" data-reveal>
          <div class="feature-icon">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="mt-5 text-lg font-semibold text-white">Always Available</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Redundant infrastructure with automatic failover ensures your utilities stay online when you need them most.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-16 lg:grid-cols-2">
        <div data-reveal>
          <span class="section-label">Our Services</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Everything you need, one platform
          </h2>
          <p class="mt-4 text-gray-400 leading-relaxed">
            From hosting your latest PvP pack to converting legacy Java textures — Sakura handles the heavy lifting so your workflow stays smooth.
          </p>

          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-tint text-emerald-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="font-medium text-white">Texture Pack Hosting</p>
                <p class="text-sm text-gray-400">Upload, share, and download .mcpack files with direct links.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-tint text-emerald-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="font-medium text-white">Java → Bedrock Conversion</p>
                <p class="text-sm text-gray-400">Automated porting with quality checks and preview thumbnails.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-tint text-emerald-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="font-medium text-white">Pack Gallery &amp; Search</p>
                <p class="text-sm text-gray-400">Browse trending packs, filter by resolution, and discover new favorites.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-tint text-emerald-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <div>
                <p class="font-medium text-white">Discord Bot Integration</p>
                <p class="text-sm text-gray-400">Convert and share packs directly from your server with one command.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Visual card stack -->
        <div class="relative" data-reveal>
          <div class="absolute -inset-4 rounded-3xl gradient-sakura-purple blur-2xl"></div>
          <div class="relative space-y-4">
            <div class="glass-card p-6 animate-float">
              <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-lg bg-gradient-to-br from-green-400 to-emerald-600 flex items-center justify-center text-white text-xs font-bold">MC</div>
                <div>
                  <p class="text-sm font-semibold text-white">PvP Pack v2.4</p>
                  <p class="text-xs text-gray-500">Converted · 32x · Bedrock</p>
                </div>
                <span class="ml-auto rounded-full bg-emerald-tint px-2.5 py-0.5 text-xs font-medium text-emerald-400">Ready</span>
              </div>
              <div class="mt-4 h-2 overflow-hidden rounded-full bg-glass-light">
                <div class="h-full w-full rounded-full progress-bar"></div>
              </div>
              <p class="mt-2 text-xs text-gray-500">Processed in 1.2s</p>
            </div>

            <div class="glass-card p-6 ml-8 animate-float-delayed">
              <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-lg bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center text-white text-xs font-bold">API</div>
                <div>
                  <p class="text-sm font-semibold text-white">POST /convert</p>
                  <p class="text-xs text-gray-500">200 OK · 48ms</p>
                </div>
                <span class="ml-auto rounded-full bg-sakura-tint px-2.5 py-0.5 text-xs font-medium text-pink-400">Secure</span>
              </div>
            </div>

            <div class="glass-card p-6">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <svg class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span class="text-sm font-medium text-white">Scan complete — no threats detected</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Security -->
  <section id="security" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="glass-card overflow-hidden">
        <div class="grid lg:grid-cols-2">
          <div class="p-8 sm:p-12" data-reveal>
            <span class="section-label">Security First</span>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Your files, protected at every step
            </h2>
            <p class="mt-4 text-gray-400 leading-relaxed">
              We treat security as a core feature, not an afterthought. Every upload is scanned, encrypted, and served over HTTPS with tamper-proof download URLs.
            </p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-subtle bg-glass-subtle p-4">
                <p class="text-2xl font-bold text-emerald-400">AES-256</p>
                <p class="mt-1 text-xs text-gray-500">Encryption at rest</p>
              </div>
              <div class="rounded-xl border border-subtle bg-glass-subtle p-4">
                <p class="text-2xl font-bold text-pink-400">TLS 1.3</p>
                <p class="mt-1 text-xs text-gray-500">In-transit protection</p>
              </div>
              <div class="rounded-xl border border-subtle bg-glass-subtle p-4">
                <p class="text-2xl font-bold text-sky-400">Auto-scan</p>
                <p class="mt-1 text-xs text-gray-500">Malware detection</p>
              </div>
              <div class="rounded-xl border border-subtle bg-glass-subtle p-4">
                <p class="text-2xl font-bold text-amber-400">Rate limit</p>
                <p class="mt-1 text-xs text-gray-500">DDoS mitigation</p>
              </div>
            </div>
          </div>

          <div class="relative flex items-center justify-center gradient-security-panel p-8 sm:p-12" data-reveal>
            <div class="text-center">
              <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-2xl icon-ring">
                <svg class="h-12 w-12 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <p class="mt-6 text-lg font-semibold text-white">Enterprise-grade security</p>
              <p class="mt-2 text-sm text-gray-400">Trusted by creators and server owners worldwide</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="get-started" class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl" data-reveal>
        <div class="absolute inset-0 gradient-cta"></div>
        <div class="absolute inset-0 grid-bg opacity-30"></div>
        <div class="relative px-8 py-16 text-center sm:px-16 sm:py-20">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Ready to get started?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-gray-300">
            Upload your first pack or browse the gallery — it takes less than a minute to join thousands of Minecraft players using Sakura.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href="/upload" class="btn-primary w-full sm:w-auto">
              Upload a pack
            </a>
            <a href="/discover" class="btn-secondary w-full sm:w-auto">
              Browse gallery
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
