<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>

    <main class="min-h-screen pt-32 pb-20 sm:pt-36">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl text-center">
                <span class="section-label">Discover</span>
                <h1 class="mt-6 text-3xl font-bold tracking-tight text-white sm:text-5xl">Popular texture packs</h1>
                <p class="mx-auto mt-4 max-w-2xl text-gray-400">Explore the most downloaded and highly-rated texture packs in the community.</p>

                <% if (packs.length > 0) { %>
                    <div class="mt-12 grid gap-6 text-left sm:grid-cols-2 lg:grid-cols-3">
                        <% packs.forEach(function(pack) { %>
                            <article class="group glass-card-hover overflow-hidden">
                                <a href="/packs/<%= pack.id %>" class="block overflow-hidden">
                                    <img src="<%= pack.thumbnail || '/images/default-thumbnail.svg' %>" alt="<%= pack.name %> thumbnail"
                                        class="h-52 w-full object-cover transition-transform duration-300 group-hover:scale-105">
                                </a>
                                <div class="p-5">
                                    <h2 class="truncate text-lg font-semibold text-white">
                                        <a href="/packs/<%= pack.id %>" class="transition-colors hover:text-pink-300"><%= pack.name %></a>
                                    </h2>
                                    <div class="mt-3 flex flex-wrap gap-2">
                                        <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-medium text-gray-300"><%= pack.resolution %></span>
                                        <% if (pack.isPort) { %>
                                            <span class="rounded-full border border-pink-400/20 bg-pink-400/10 px-2.5 py-1 text-xs font-medium text-pink-300">Port</span>
                                        <% } %>
                                    </div>
                                    <div class="mt-5 flex items-center justify-between gap-3 text-xs text-gray-400">
                                        <span class="flex min-w-0 items-center gap-2 truncate">
                                            <img src="/images/default-avatar.svg" alt="" class="h-8 w-8 shrink-0 rounded-full border border-white/10">
                                            <span class="truncate"><%= pack.uploader %></span>
                                        </span>
                                        <span class="shrink-0 text-gray-500"><%= (pack.downloads || 0).toLocaleString() %> downloads</span>
                                    </div>
                                </div>
                            </article>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="glass-card mx-auto mt-12 max-w-2xl p-10 text-center">
                        <p class="text-gray-400">No texture packs available yet.</p>
                        <a href="/upload" class="btn-primary mt-6">Be the first to upload</a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>