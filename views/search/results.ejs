<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/tailwind.css">
    <link rel="stylesheet" href="/css/legacy-pages.css">
    <style>
      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-up { animation: fadeInUp 0.6s ease-out forwards; }
    </style>
</head>
<body class="sakura-page antialiased">
    <nav class="sakura-nav">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
            <div class="flex-shrink-0">
                <a href="/" class="sakura-brand">Sakura<span>.xyz</span></a>
            </div>
            <div class="hidden md:flex md:items-center md:space-x-8">
                <a href="/" class="sakura-nav-link">Home</a><a href="/search" class="sakura-nav-link">Search</a><a href="/discover" class="sakura-nav-link">Discover</a><a href="/upload" class="sakura-nav-link">Upload</a><a href="/random" class="sakura-nav-link">Random</a><a href="/shop" class="sakura-nav-link">Shop</a><a href="/profile" class="sakura-nav-link">Profile</a>
            </div>
        </div>
    </nav>

    <main class="sakura-main">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 animate-fade-in-up">
            <div class="sakura-detail-card">
                <h1 class="pack-title">Search Texture Packs</h1>
                <form action="/search" method="GET" class="mb-6 flex items-center space-x-3">
                        <input type="text" name="q" value="<%= query || '' %>" placeholder="Search for texture packs..." class="sakura-input w-full sm:w-96">
                    <button type="submit"
                        class="sakura-button">
                        Search
                    </button>
                </form>

                <% if (results.length > 0) { %>
                    <div class="mb-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-2">
                            Found <%= results.length %> result<%= results.length !== 1 ? 's' : '' %>
                        </h2>
                    </div>
                    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                        <% results.forEach(function(pack) { %>
                            <div class="sakura-pack-card">
                                <a href="/packs/<%= pack.id %>" class="block">
                                    <img src="<%= pack.thumbnail || '/images/default-thumbnail.svg' %>" alt="<%= pack.name %> Thumbnail"
                                        class="w-full h-48 object-cover">
                                </a>
                                <div class="p-5">
                                    <h3 class="pack-title">
                                        <a href="/packs/<%= pack.id %>" class="hover:text-indigo-600 transition-colors"><%= pack.name %></a>
                                    </h3>
                                    <div class="flex flex-wrap gap-3 mb-3">
                                        <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded-full"><%= pack.resolution %></span>
                                        <% if (pack.isPort) { %>
                                            <span class="bg-red-100 text-red-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Port</span>
                                        <% } %>
                                    </div>
                                    <div class="flex items-center justify-between text-sm text-gray-500">
                                        <span>
                                            <img src="/images/default-avatar.svg" alt="Uploader Avatar" class="w-8 h-8 rounded-full mr-2">
                                            <%= pack.uploader %>
                                        </span>
                                        <span><%= (pack.downloads || 0).toLocaleString() %> downloads</span>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else if (query) { %>
                    <div class="text-center py-12">
                        <p class="text-gray-500">No texture packs found matching "<%= query %>".</p>
                        <a href="/upload"
                            class="sakura-button mt-4">
                            Upload Your First Pack
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 text-gray-300 py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-center text-sm">&copy; 2026 TexturePack.xyz. All rights reserved.</p>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>