<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="min-h-screen pt-24 pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <a href="/dashboard" class="text-sm text-gray-400 hover:text-pink-300">← Back to dashboard</a>
          <h1 class="mt-3 text-3xl font-bold tracking-tight text-white"><%= meta.id %></h1>
          <p class="mt-2 text-gray-400"><%= meta.documentCount %> documents in this collection</p>
        </div>
        <a href="/api/firebase/collections/<%= meta.id %>?limit=50" class="btn-secondary text-xs" target="_blank" rel="noopener">View JSON</a>
      </div>

      <% if (!data.documents.length) { %>
        <div class="mt-8 glass-card p-8 text-center text-gray-400">
          This collection is empty.
        </div>
      <% } else { %>
        <div class="mt-8 overflow-x-auto rounded-2xl border border-subtle">
          <table class="min-w-full divide-y divide-white/5">
            <thead class="bg-glass-subtle">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Document ID</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-400">Preview</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% data.documents.forEach(function(doc) { %>
                <tr class="hover-bg-glass-light align-top">
                  <td class="px-4 py-4 text-sm font-medium text-pink-300 whitespace-nowrap"><%= doc.id %></td>
                  <td class="px-4 py-4">
                    <pre class="max-w-4xl overflow-x-auto rounded-lg bg-glass-subtle p-3 text-xs text-gray-300"><%= JSON.stringify(doc, null, 2) %></pre>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
