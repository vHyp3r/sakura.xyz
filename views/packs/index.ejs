<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/tailwind.css"><link rel="stylesheet" href="/css/legacy-pages.css">
</head>
<body class="library-page">
  <%- include('../partials/nav') %>
  <main class="library-main">
    <div class="library-toolbar">
      <nav class="library-tabs" aria-label="Library filters"><a class="active" href="/packs">◈ Trending</a><a href="/discover">◉ Popular</a><a href="/search?q=downloads">⇩ Downloads</a><a href="/search?q=liked">♡ Liked</a><a href="/search?q=new">◷ Added</a></nav>
      <div class="library-actions"><a href="/upload" class="library-upload">↥ Upload</a><a href="/search" class="library-filter">⌕ Filters</a></div>
    </div>
    <section class="library-heading"><div><span class="library-kicker">Community library</span><h1>Texture packs <small><%= packs.length %> available</small></h1></div><form action="/search" method="GET"><input name="q" type="search" placeholder="Search the library..."><button type="submit">Search</button></form></section>
    <% if (packs.length) { %>
      <div class="pack-grid">
        <% packs.forEach(function(pack, index) { %>
          <article class="pack-card">
            <a href="/packs/<%= pack._id %>" class="pack-image-link"><img src="<%= pack.thumbnail || '/images/default-thumbnail.svg' %>" alt="<%= pack.name %> preview" class="pack-image" loading="lazy" onerror="this.onerror=null;this.src='/images/default-thumbnail.svg';"><span class="pack-resolution"><%= pack.resolution || 'PACK' %></span><span class="pack-rank">#<%= index + 1 %></span></a>
            <div class="pack-card-body"><h2><a href="/packs/<%= pack._id %>"><%= pack.name %></a></h2><p class="pack-author">◉ by <%= pack.uploader || 'Anonymous' %></p><div class="pack-tags"><% if (pack.category) { %><span><%= pack.category %></span><% } %><% (pack.tags || []).slice(0, 3).forEach(function(tag) { %><span><%= tag %></span><% }); %><% if ((pack.tags || []).length > 3) { %><span>+<%= pack.tags.length - 3 %></span><% } %></div><div class="pack-card-meta"><span>◉ <%= (pack.downloads || 0).toLocaleString() %></span><span>↧ <%= pack.originalFileName || 'mcpack' %></span></div></div>
          </article>
        <% }); %>
      </div>
    <% } else { %><div class="library-empty"><h2>No packs yet</h2><p>Upload the first texture pack to start the library.</p><a href="/upload" class="library-upload">Upload a pack</a></div><% } %>
  </main>
  <script src="/js/main.js"></script>
</body>
</html>
