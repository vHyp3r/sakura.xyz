<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/tailwind.css"><link rel="stylesheet" href="/css/legacy-pages.css">
</head>
<body class="library-page">
  <%- include('../partials/nav') %>
  <main class="detail-main">
    <p class="detail-breadcrumb"><a href="/packs">‹ Library</a> / <%= pack.category || 'Texture pack' %> / <span><%= pack.name %></span></p>
    <div class="detail-layout">
      <section class="detail-media"><div class="media-tabs"><span class="active">▧ Screenshot</span><span>◉ Clip</span></div><div class="detail-image-wrap"><img src="<%= pack.thumbnail || '/images/default-thumbnail.svg' %>" alt="<%= pack.name %> screenshot" onerror="this.onerror=null;this.src='/images/default-thumbnail.svg';"><span class="media-label">● SCREENSHOT 1 / 1</span><span class="media-resolution"><%= pack.resolution || 'PACK' %></span></div><p class="detail-description"><%= pack.description || 'No description provided for this texture pack.' %></p></section>
      <aside class="detail-panel"><div class="detail-title"><h1><%= pack.name %></h1><p><span class="online-dot"></span> Community pack <span>·</span> <%= pack.resolution || 'Bedrock' %></p></div><div class="detail-creator"><img src="/images/default-avatar.svg" alt=""><div><span>CREATED BY</span><strong><%= pack.uploader || 'Anonymous' %></strong></div><a href="/search?q=<%= encodeURIComponent(pack.uploader || '') %>">＋ FOLLOW</a></div><div class="detail-stats"><div><strong><%= (pack.downloads || 0).toLocaleString() %></strong><span>DOWNLOADS</span></div><div><strong><%= pack.category || 'OTHER' %></strong><span>CATEGORY</span></div><div><strong><%= (pack.tags || []).length %></strong><span>TAGS</span></div></div><div class="edition-switch"><span class="active">◈ Bedrock</span><span>Java Edition</span></div><div class="version-select">✓ Minecraft Bedrock <span>⌄</span></div><% if (fileAvailable) { %><a class="detail-download" href="/packs/<%= pack._id %>/download">⇩ &nbsp; DOWNLOAD</a><% } else { %><div class="detail-unavailable">Download file unavailable</div><% } %><a class="detail-secondary" href="/packs">＋ ADD TO LIBRARY</a><div class="detail-actions"><button type="button">♡</button><button type="button">⌁</button><button type="button">◌</button><button type="button">⌯</button></div></aside>
    </div>
  </main>
  <script src="/js/main.js"></script>
</body>
</html>
