# Firebase
FIREBASE_PROJECT_ID=your-project-id

# Path to the service account JSON downloaded from Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json

# Optional: comma-separated Firestore collections to show on the dashboard
# Leave empty to auto-discover all root collections
FIREBASE_DASHBOARD_COLLECTIONS=

# Optional: Realtime Database URL (only needed if you use RTDB later)
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Server
PORT=3000

# Admin access
# Comma-separated profile usernames allowed to sign in to /admin
ADMIN_USERNAMES=admin
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Account database (defaults to MONGODB_URI and the accountInfo database)
# SRV URIs must not include a port such as :27017.
# ACCOUNTINFO_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sakura
ACCOUNTINFO_DB_NAME=accountInfo
ACCOUNT_SESSION_SECRET=replace-with-another-long-random-secret
# Minimum seconds between admin balance changes for the same username
ADMIN_COIN_UPDATE_COOLDOWN_SECONDS=300
